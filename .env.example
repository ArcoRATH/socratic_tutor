# --- The Socratic Brain (LLM) ---
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Verified on free tier: gemini-3.5-flash (JSON mode works).
# With billing: gemini-3.1-pro-preview. Retired/zero-quota: 1.5-pro, 2.5-pro, 3.1-pro.
LLM_MODEL=gemini-3.5-flash

# --- The Semantic Memory (Embeddings) ---
# SiliconFlow (OpenAI-compatible): https://cloud.siliconflow.cn/account/ak
# Optional — without a key, sections are stored unembedded and teaching still works.
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# BAAI/bge-m3 outputs a fixed 1024 dims (must match Vector(1024) in models.py).
# Do not rely on per-request `dimensions` — bge-m3 rejects that parameter.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# --- The Messenger (Telegram) ---
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- The Vault (Database) ---
# docker compose overrides this to postgresql://postgres:postgres@db:5432/socratic_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socratic_db

# --- App Settings ---
DEBUG=False
LOG_LEVEL=INFO
# Max sections to embed per document; the rest are stored unembedded and remain teachable
MAX_EMBED_CHUNKS=30
